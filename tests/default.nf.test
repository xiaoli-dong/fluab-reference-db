nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test,singularity") {

        when {
            params {
                seq_json_file = "$baseDir/tests/test_data/influenza_ab_sequences_raw.json"
                meta_json_file = "$baseDir/tests/test_data/influenza_ab_meta_raw.json"
                db_version = "influenza_ab_test"
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/*.{html,json,txt}']
            )

            def stable_content = getAllFilesFromDir(
                params.outdir,
                ignoreFile: 'tests/.nftignore'
            )

            assert workflow.success

            assertAll(
                {
                    assert snapshot(
                        removeNextflowVersion(
                            "$outputDir/pipeline_info/fluab_reference_db_software_versions.yml"
                        ),
                        stable_path,
                        stable_content
                    ).match()
                }
            )
        }
    }
}
